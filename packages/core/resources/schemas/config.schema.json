{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "title": "axiomasoft/sockit configuration",
    "type": "object",
    "properties": {
        "sections": {
            "type": "object",
            "properties": {
                "sockit.ids": {
                    "type": "object",
                    "description": "Identifier generation strategy configuration."
                },
                "sockit.modules": {
                    "type": "object",
                    "description": "Module activation and global per-module setting defaults."
                },
                "sockit.operations": {
                    "type": "object",
                    "description": "Command envelope and outbox execution limits."
                },
                "sockit.panels": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Declared PanelProvider classes."
                },
                "sockit.privacy": {
                    "type": "object",
                    "description": "Platform-wide privacy floor bounds."
                },
                "sockit.resolvers": {
                    "type": "object",
                    "description": "Host SPI resolver class bindings."
                },
                "sockit.storage": {
                    "type": "object",
                    "description": "Default database storage settings."
                },
                "sockit.surfaces": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [],
                    "description": "Declared SurfaceProvider classes."
                }
            },
            "additionalProperties": false
        },
        "sockit": {
            "type": "object",
            "properties": {
                "ids": {
                    "type": "object",
                    "properties": {
                        "strategy": {
                            "type": "string",
                            "default": "uuid7"
                        }
                    },
                    "additionalProperties": false
                },
                "modules": {
                    "type": "object",
                    "properties": {
                        "enabled": {
                            "type": [
                                "array",
                                "object"
                            ]
                        },
                        "settings": {
                            "type": [
                                "array",
                                "object"
                            ]
                        }
                    },
                    "additionalProperties": false
                },
                "operations": {
                    "type": "object",
                    "properties": {
                        "outbox_batch_size": {
                            "type": "integer",
                            "default": 100
                        },
                        "receipt_ttl_seconds": {
                            "type": "integer",
                            "default": 86400
                        }
                    },
                    "additionalProperties": false
                },
                "panels": {
                    "type": [
                        "array",
                        "object"
                    ]
                },
                "privacy": {
                    "type": "object",
                    "properties": {
                        "floor": {
                            "type": "object",
                            "properties": {
                                "allowed_scopes": {
                                    "type": "array"
                                },
                                "contour_levels": {
                                    "type": [
                                        "array",
                                        "object"
                                    ]
                                },
                                "default_scope": {
                                    "type": "string",
                                    "default": "direct"
                                },
                                "max_scope": {
                                    "type": "string",
                                    "default": "direct"
                                },
                                "minor_default_scope": {
                                    "type": "string",
                                    "default": "direct"
                                },
                                "minor_max_scope": {
                                    "type": "string",
                                    "default": "direct"
                                }
                            },
                            "additionalProperties": false
                        }
                    },
                    "additionalProperties": false
                },
                "resolvers": {
                    "type": "object",
                    "properties": {
                        "actor": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "audience": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "authorizer": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "contour": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "groups": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "surface_policy": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "targets": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "tenant": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        }
                    },
                    "additionalProperties": false
                },
                "storage": {
                    "type": "object",
                    "properties": {
                        "connection": {
                            "type": [
                                "string",
                                "null"
                            ],
                            "default": null
                        },
                        "table_prefix": {
                            "type": "string",
                            "default": "sk_"
                        }
                    },
                    "additionalProperties": false
                },
                "surfaces": {
                    "type": [
                        "array",
                        "object"
                    ]
                }
            },
            "additionalProperties": false
        }
    },
    "additionalProperties": false
}
