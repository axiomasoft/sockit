{
    "name": "axiomasoft/sockit",
    "description": "Embeddable social engine for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/config": "^13.0",
        "ramsey/uuid": "^4.9",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-plugins": "^0.1.1"
    },
    "autoload": {
        "psr-4": {
            "SocKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocKit\\SocKitServiceProvider"
            ]
        },
        "sockit": {
            "owners": {
                "core": {
                    "namespaces": [
                        "SocKit\\"
                    ],
                    "paths": [
                        "packages/core/src",
                        "packages/core/config",
                        "packages/core/resources"
                    ],
                    "tables": [
                        "surface_instances",
                        "receipts",
                        "outbox",
                        "tombstones"
                    ],
                    "config": [
                        "sockit"
                    ],
                    "publish-tags": [
                        "sockit-config"
                    ],
                    "commands": [
                        "sockit:diagnose",
                        "sockit:outbox:run",
                        "sockit:panel:migrations",
                        "sockit:doctor",
                        "sockit:make-panel",
                        "sockit:relay"
                    ],
                    "module-ids": [],
                    "exclude-namespaces": [
                        "SocKit\\Reactions\\",
                        "SocKit\\Posts\\",
                        "SocKit\\Groups\\"
                    ]
                }
            }
        },
        "packman": {
            "error-prefix": "sockit",
            "package-type": "domain",
            "schema-version": 1,
            "stability": "dev",
            "owns": [
                "Actors",
                "Audience",
                "Configuration",
                "Diagnostics",
                "Errors",
                "Internal",
                "Modules",
                "Operations",
                "Panels",
                "Plugins",
                "Schema",
                "Support",
                "Surfaces",
                "Testing"
            ]
        }
    }
}
