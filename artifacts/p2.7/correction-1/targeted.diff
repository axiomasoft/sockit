+<?php
+
+declare(strict_types=1);
+
+namespace SocKit\Operations\Contracts;
+
+use SocKit\Attributes\Spi;
+use SocKit\Attributes\SpiKind;
+use SocKit\Audience\Data\AuthorizationDecision;
