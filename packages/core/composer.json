{
    "name": "axiomasoft/sockit",
    "description": "Embeddable social engine for Laravel",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "illuminate/support": "^13.0",
        "illuminate/contracts": "^13.0",
        "illuminate/container": "^13.0",
        "illuminate/config": "^13.0",
        "ramsey/uuid": "^4.9",
        "illuminate/database": "^13.0",
        "illuminate/console": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "SocKit\\": "src/",
            "SocKit\\Reactions\\": "modules/reactions/src/",
            "SocKit\\Posts\\": "modules/posts/src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "SocKit\\SocKitServiceProvider"
            ]
        },
        "sockit": {
            "owners": {
                "core": {
                    "namespaces": [
                        "SocKit\\"
                    ],
                    "paths": [
                        "packages/core/src",
                        "packages/core/config",
                        "packages/core/resources"
                    ],
                    "tables": [
                        "surface_instances",
                        "receipts",
                        "outbox",
                        "tombstones"
                    ],
                    "config": [
                        "sockit"
                    ],
                    "publish-tags": [
                        "sockit-config"
                    ],
                    "commands": [
                        "sockit:doctor",
                        "sockit:make-panel",
                        "sockit:relay"
                    ],
                    "module-ids": [],
                    "exclude-namespaces": [
                        "SocKit\\Reactions\\",
                        "SocKit\\Posts\\"
                    ]
                },
                "reactions": {
                    "namespaces": [
                        "SocKit\\Reactions\\"
                    ],
                    "paths": [
                        "packages/core/modules/reactions/src"
                    ],
                    "tables": [
                        "reactions",
                        "reaction_counts"
                    ],
                    "config": [],
                    "publish-tags": [],
                    "commands": [],
                    "module-ids": [
                        "sockit.reactions"
                    ]
                },
                "posts": {
                    "namespaces": [
                        "SocKit\\Posts\\"
                    ],
                    "paths": [
                        "packages/core/modules/posts/src"
                    ],
                    "tables": [
                        "posts",
                        "post_revisions"
                    ],
                    "config": [],
                    "publish-tags": [],
                    "commands": [],
                    "module-ids": [
                        "sockit.posts"
                    ]
                }
            }
        }
    }
}
