{
    "name": "axiomasoft/sockit-posts",
    "description": "Posts module for the SocKit social engine for Laravel.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.4",
        "axiomasoft/sockit": "^0.1@dev",
        "axiomasoft/packman": "^0.1",
        "illuminate/database": "^13.0",
        "illuminate/support": "^13.0",
        "axiomasoft/packman-plugins": "^0.1.2"
    },
    "autoload": {
        "psr-4": {
            "SocKit\\Posts\\": "src/"
        }
    },
    "extra": {
        "packman": {
            "schema-version": 1,
            "package-type": "domain",
            "stability": "dev",
            "owns": [
                "Contracts",
                "Data",
                "Enums",
                "Exceptions",
                "Internal"
            ]
        },
        "sockit": {
            "owners": {
                "posts": {
                    "namespaces": [
                        "SocKit\\Posts\\"
                    ],
                    "paths": [
                        "packages/posts/src"
                    ],
                    "tables": [
                        "posts",
                        "post_revisions"
                    ],
                    "config": [],
                    "publish-tags": [],
                    "commands": [],
                    "module-ids": [
                        "sockit.posts"
                    ]
                }
            }
        }
    }
}
