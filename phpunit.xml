<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="default"
         failOnWarning="true"
         failOnRisky="true"
         failOnEmptyTestSuite="false"
         beStrictAboutOutputDuringTests="true"
>
    <testsuites>
        <testsuite name="Core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="Testkit">
            <directory>packages/testkit/tests</directory>
        </testsuite>
        <testsuite name="Monorepo">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/testkit/src</directory>
        </include>
    </source>

    <php>
        <ini name="memory_limit" value="1G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="CACHE_DRIVER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="PACKMAN_TEST_DESTRUCTIVE_OPT_IN" value="1"/>
        <env name="PGSQL_HOST" value="127.0.0.1"/>
        <env name="PGSQL_PORT" value="54329"/>
        <env name="PGSQL_DATABASE" value="sockit_test"/>
        <env name="PGSQL_USERNAME" value="skm"/>
        <env name="PGSQL_PASSWORD" value="skm_dev"/>
    </php>
</phpunit>
