{
    "name": "acme/sockit-consumer",
    "type": "project",
    "require": {
        "php": "^8.4",
        "laravel/framework": "^13.0",
        "axiomasoft/sockit": "^0.1@dev",
        "axiomasoft/sockit-reactions": "^0.1@dev",
        "axiomasoft/sockit-posts": "^0.1@dev",
        "axiomasoft/sockit-groups": "^0.1@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../../packages/*",
            "options": {
                "symlink": false,
                "reference": "config",
                "versions": {
                    "axiomasoft/sockit": "0.1.x-dev",
                    "axiomasoft/sockit-reactions": "0.1.x-dev",
                    "axiomasoft/sockit-posts": "0.1.x-dev",
                    "axiomasoft/sockit-groups": "0.1.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../../../vendor/axiomasoft/packman*",
            "options": {
                "symlink": false,
                "reference": "config",
                "versions": {
                    "axiomasoft/packman": "0.1.1",
                    "axiomasoft/packman-plugins": "0.1.1"
                }
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "Acme\\": "app/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
