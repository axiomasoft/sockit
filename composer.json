{
    "name": "axiomasoft/sockit-monorepo",
    "description": "Development monorepo for SocKit — panel-based social engine for Laravel applications (surfaces, reactions, posts, feeds, groups, and audience privacy).",
    "type": "project",
    "license": "proprietary",
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/sockit": "1.0.x-dev",
                    "axiomasoft/sockit-testkit": "1.0.x-dev"
                }
            }
        },
        {
            "type": "path",
            "url": "../packman/packages/*",
            "options": {
                "symlink": true,
                "versions": {
                    "axiomasoft/packman": "0.1.x-dev",
                    "axiomasoft/packman-schema": "0.1.x-dev",
                    "axiomasoft/packman-plugins": "0.1.x-dev",
                    "axiomasoft/packman-panels": "0.1.x-dev",
                    "axiomasoft/packman-filament": "0.1.x-dev",
                    "axiomasoft/packman-testkit": "0.1.x-dev",
                    "axiomasoft/packman-devtools": "0.1.x-dev"
                }
            }
        }
    ],
    "require": {
        "php": ">=8.4 <8.6",
        "ext-intl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "axiomasoft/packman": "^0.1",
        "axiomasoft/packman-panels": "^0.1",
        "axiomasoft/packman-plugins": "^0.1",
        "axiomasoft/packman-schema": "^0.1",
        "axiomasoft/sockit": "^1.0",
        "ramsey/uuid": "^4.9"
    },
    "require-dev": {
        "axiomasoft/packman-devtools": "^0.1",
        "axiomasoft/packman-testkit": "^0.1",
        "axiomasoft/sockit-testkit": "^1.0",
        "driftingly/rector-laravel": "^2.7",
        "larastan/larastan": "^3.12",
        "laravel/pint": "^1.32",
        "orchestra/testbench": "^11.3",
        "pestphp/pest": "^5.2",
        "phpstan/phpstan": "^2.2.16 <2.3.6",
        "phpstan/phpstan-strict-rules": "^2.0.12",
        "rector/rector": "^2.6"
    },
    "autoload-dev": {
        "psr-4": {
            "SocKit\\Tests\\": "tests/",
            "SocKit\\Core\\Tests\\": "packages/core/tests/",
            "SocKit\\Testkit\\Tests\\": "packages/testkit/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "scripts": {
        "lint": "vendor/bin/pint",
        "lint:check": "vendor/bin/pint --test",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G --no-progress",
        "refactor": "vendor/bin/rector process",
        "refactor:check": "vendor/bin/rector process --dry-run",
        "test": "vendor/bin/pest --exclude-group=pg",
        "test:pg": "vendor/bin/pest --group=pg",
        "gate": "@php vendor/bin/packman gate",
        "php-api": "@php vendor/bin/packman php-api --check",
        "error-codes": "@php vendor/bin/packman error-codes --check",
        "config-schema": "@php vendor/bin/packman config-schema --check",
        "ai:sync": "@php vendor/bin/packman ai:sync --dry-run"
    }
}
