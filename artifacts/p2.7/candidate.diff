@@ -0,0 +1,95 @@
+<?php
+
+declare(strict_types=1);
+
+namespace SocKit\Tests\Fixtures\Runtime;
+
+use Illuminate\Database\Connection;
+use SocKit\Audience\Data\AudienceSpec;
+use SocKit\Audience\Data\AudienceSubject;
+use SocKit\Audience\Data\AuthorizationDecision;
+use SocKit\Operations\Contracts\OwnerMutation;
+use SocKit\Operations\Data\MutationEffect;
+use SocKit\Operations\Data\MutationEvent;
+use SocKit\Operations\Data\MutationRequest;
+use SocKit\Operations\Data\MutationSnapshot;
+use SocKit\Operations\Data\OperationHandle;
+use SocKit\Support\Data\HostEntityRef;
+use SocKit\Support\Data\ResourceRef;
+use SocKit\Support\Data\Revision;
+use SocKit\Support\Enums\ResourceKind;
+use SocKit\Surfaces\Data\Incarnation;
+use SocKit\Surfaces\Data\TargetRef;
+use SocKit\Surfaces\Enums\TargetLifecycle;
+
+/** Real acme owner state/revision SQL. No social domain is implemented by this fixture. */
+final class EnvelopeMutation implements OwnerMutation
+{
+    public const TYPE = 'acme.runtime.mutate';
+
+    public int $writes = 0;
+
+    public int $locks = 0;
+
+    public int $value = 1;
+
+    public string $targetKey = '42';
+
+    public int $incarnation = 1;
+
+    public string $bad = '';
+
+    public ?AudienceSpec $proposed = null;
+
+    public ?AuthorizationDecision $safety = null;
+
+    /** @var array<string, mixed> */
+    public array $extraPayload = [];
+
+    public function __construct(private readonly Connection $connection) {}
+
+    public function commandType(): string
+    {
+        return self::TYPE;
+    }
+
+    public function payload(): array
+    {
+        return ['value' => $this->value, ...$this->extraPayload];
+    }
+
+    public function request(OperationHandle $handle): MutationRequest
+    {
+        if ($this->connection->transactionLevel() !== 0) {
+            throw new \LogicException('request under tx');
+        }
+
+        return new MutationRequest(action: self::TYPE, subject: new AudienceSubject(key: 'acme.subject', spec: AudienceSpec::direct($handle->actor->actor ?? throw new \RuntimeException('actor required')), author: null, surface: $handle->surface, installation: $handle->actor->installation),
+            intent: $this->proposed === null ? 'write' : 'publish', safety: $this->safety ?? AuthorizationDecision::allow('fixture.safe'), generation: '1',
+            target: new TargetRef(host: new HostEntityRef(type: 'article', value: $this->targetKey), incarnation: new Incarnation($this->incarnation)), proposedAudience: $this->proposed);
+    }
+
+    public function lock(OperationHandle $handle): MutationSnapshot
+    {
+        $this->locks++;
+        $row = $this->connection->table('panel_a.envelope_revisions')->where('target', $this->targetKey)->lockForUpdate()->first();
+        if ($row === null || ! is_string($row->resource) || ! is_int($row->revision)) {
+            throw new \RuntimeException('Missing fixture revision');
+        }
+
+        return new MutationSnapshot(resource: new ResourceRef(panel: $handle->surface->panel, kind: ResourceKind::SurfaceInstance, id: $row->resource), revision: new Revision($row->revision), lifecycle: TargetLifecycle::Live,
+            generation: $this->bad === 'generation' ? 'stale' : '1', safety: $this->bad === 'safety' ? AuthorizationDecision::unknown('fixture.safety_unknown') : AuthorizationDecision::allow('fixture.safe'));
+    }
+
+    public function persist(OperationHandle $handle, MutationSnapshot $snapshot): MutationEffect
+    {
+        $this->writes++;
+        $this->connection->table('panel_a.envelope_state')->where('target', $this->targetKey)->increment('effects', $this->value);
+        $affected = $this->connection->table('panel_a.envelope_revisions')->where('target', $this->targetKey)->where('revision', $snapshot->revision?->value)->update(['revision' => $snapshot->revision?->next()->value]);
+        $resource = $snapshot->resource ?? throw new \RuntimeException('No fixture resource');
+
+        return new MutationEffect(affectedRows: $this->bad === 'rows' ? 0 : $affected, resource: $resource,
+            newRevision: $this->bad === 'revision' ? new Revision(99) : ($snapshot->revision?->next() ?? new Revision(1)),
+            events: $this->bad === 'events' ? [] : [new MutationEvent(type: 'acme.runtime.changed', refs: ['resource' => $resource])]);
+    }
+}

diff --git a/tests/Fixtures/Runtime/EnvelopeRace.php b/tests/Fixtures/Runtime/EnvelopeRace.php
new file mode 100644
index 0000000..69620db
--- /dev/null
+++ b/tests/Fixtures/Runtime/EnvelopeRace.php
@@ -0,0 +1,104 @@
+<?php
+
+declare(strict_types=1);
+
+namespace SocKit\Tests\Fixtures\Runtime;
+
+use SocKit\Operations\Data\OperationResult;
+
+final class EnvelopeRace
+{
+    /** @return list<OperationResult> */
+    public static function run(EnvelopeScenario $s, string $mode): array
+    {
+        $processes = $streams = $pids = [];
+        try {
+            foreach (['hold', 'wait'] as $i => $role) {
+                $process = proc_open([PHP_BINARY, __DIR__.'/envelope-child.php', $role, $mode], [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
+                if (! is_resource($process)) {
+                    throw new \RuntimeException('Could not start contender');
+                }
+                $processes[$i] = $process;
+                $streams[$i] = $pipes;
+                stream_set_timeout($pipes[1], 10);
+                $pids[$i] = (int) fgets($pipes[1]);
+                if ($i === 0) {
+                    expect(trim((string) fgets($pipes[1])))->toBe('claimed');
+                }
+            }
+            expect($pids[0])->toBeGreaterThan(0)->and($pids[1])->toBeGreaterThan(0)->and($pids[0])->not->toBe($pids[1]);
+            $deadline = microtime(true) + 5;
+            do {
+                $query = $s->base->db->owner->prepare('SELECT wait_event_type, pg_blocking_pids(pid) @> ARRAY[?]::int[] AS holder FROM pg_stat_activity WHERE pid=?');
+                $query->execute([$pids[0], $pids[1]]);
+                $row = $query->fetch(\PDO::FETCH_ASSOC);
+                $blocked = is_array($row) && $row['wait_event_type'] === 'Lock' && $row['holder'] === true;
+                if (! $blocked) {
+                    usleep(10000);
+                }
+            } while (! $blocked && microtime(true) < $deadline);
+            fwrite(STDERR, 'P2.7 barrier '.$mode.' holder='.$pids[0].' waiter='.$pids[1].' blocked_by_holder='.($blocked ? 'true' : 'FALSE').PHP_EOL);
+            expect($blocked)->toBeTrue();
+            if ($mode === 'revoke') {
+                $s->base->db->owner->exec('UPDATE panel_a.driver_envelope_authority SET allowed=false');
+            }
+            fwrite($streams[0][0], "release\n");
+            fflush($streams[0][0]);
+            $results = [];
+            foreach ($processes as $i => $process) {
+                $output = (string) stream_get_contents($streams[$i][1]);
+                $error = (string) stream_get_contents($streams[$i][2]);
+                foreach ($streams[$i] as $pipe) {
+                    fclose($pipe);
+                }
+                expect(proc_close($process))->toBe(0, $error);
+                unset($processes[$i]);
+                $wire = json_decode($output, true, flags: JSON_THROW_ON_ERROR);
+                if (! is_array($wire)) {
+                    throw new \RuntimeException('Invalid contender result');
+                }
+                $result = [];
+                foreach ($wire as $key => $value) {
+                    if (! is_string($key)) {
+                        throw new \RuntimeException('Invalid contender key');
+                    } $result[$key] = $value;
+                }
+                foreach (['resolvers', 'authority'] as $stage) {
+                    $levels = $result[$stage] ?? null;
+                    if (! is_array($levels)) {
+                        throw new \RuntimeException('Missing resolver levels');
+                    }
+                    if ($stage === 'authority' || ! in_array($mode, ['archive', 'delete'], true) || $i === 1) {
+                        foreach ($levels as $level) {
+                            expect($level)->toBe(0);
+                        }
+                        expect($levels)->not->toBe([]);
+                    } else {
+                        expect($levels)->toBe([]);
+                    }
+                }
+                expect($result['level'])->toBe(0);
+                $outcome = $result['result'] ?? null;
+                if (! is_array($outcome)) {
+                    throw new \RuntimeException('Missing contender outcome');
+                }
+                $validated = [];
+                foreach ($outcome as $key => $value) {
+                    if (! is_string($key)) {
+                        throw new \RuntimeException('Invalid outcome key');
+                    } $validated[$key] = $value;
+                }
+                $results[] = OperationResult::fromWire($validated);
+                fwrite(STDERR, $error);
+            }
+            fwrite(STDERR, 'P2.7 race outcomes '.json_encode($results, JSON_THROW_ON_ERROR).PHP_EOL);
+
+            return $results;
+        } finally {
+            foreach ($processes as $process) {
+                proc_terminate($process);
+                proc_close($process);
+            }
+        }
+    }
+}

