{
  "extraKnownMarketplaces": {
    "swissknifeman": {
      "source": {
        "source": "directory",
        "path": "<ABS_PATH_TO_SWISSKNIFEMAN>"
      }
    }
  },
  "enabledPlugins": {
    "analyst@swissknifeman": true,
    "brain@swissknifeman": true,
    "core@swissknifeman": true,
    "devops@swissknifeman": true,
    "harness@swissknifeman": true,
    "laravel-testing@swissknifeman": true,
    "maind@swissknifeman": true,
    "oss-dev@swissknifeman": true,
    "php@swissknifeman": true,
    "php-packages@swissknifeman": true,
    "planner@swissknifeman": true,
    "quality@swissknifeman": true
  },
  "permissions": {
    "ask": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(chmod -R *)",
      "Bash(chown *)"
    ],
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(**/*.pem)",
      "Bash(sudo *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.production)",
      "Read(**/*.key)",
      "Read(~/.claude/logs/**)",
      "Read(**/skills.json)",
      "Read(**/package-lock.json)",
      "Read(**/composer.lock)",
      "Read(**/*.lock)"
    ],
    "defaultMode": "bypassPermissions",
    "allow": [
      "Bash(git *)",
      "Bash(gh pr *)",
      "Bash(gh issue *)",
      "Bash(gh run *)",
      "Bash(gh api *)",
      "Bash(gh repo view *)",
      "Bash(mkdir *)",
      "Bash(touch *)",
      "Bash(cp *)",
      "Bash(mv *)",
      "Bash(ln -s *)",
      "Bash(chmod +x *)",
      "Bash(tar *)",
      "Bash(zip *)",
      "Bash(unzip *)",
      "Bash(rg *)",
      "Bash(jq *)",
      "Bash(sed *)",
      "Bash(awk *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(xargs rg *)",
      "Bash(make *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(* --version)",
      "Bash(* --help)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:api.github.com)",
      "Workflow",
      "Agent",
      "TodoWrite",
      "Bash(php -l *)",
      "Bash(php -r *)",
      "Bash(php -v)",
      "Bash(composer install *)",
      "Bash(composer update *)",
      "Bash(composer require *)",
      "Bash(composer remove *)",
      "Bash(composer dump-autoload *)",
      "Bash(composer run *)",
      "Bash(composer test *)",
      "Bash(composer validate *)",
      "Bash(composer show *)",
      "Bash(vendor/bin/pest *)",
      "Bash(vendor/bin/phpunit *)",
      "Bash(vendor/bin/pint *)",
      "Bash(vendor/bin/phpstan *)",
      "Bash(vendor/bin/rector *)",
      "Bash(vendor/bin/infection *)",
      "Bash(./vendor/bin/pest *)",
      "Bash(./vendor/bin/phpunit *)",
      "Bash(./vendor/bin/pint *)",
      "Bash(./vendor/bin/phpstan *)",
      "Bash(./vendor/bin/rector *)"
    ]
  },
  "outputStyle": "lean"
}
