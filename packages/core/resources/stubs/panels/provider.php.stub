<?php

declare(strict_types=1);

namespace {{NAMESPACE}};

use SocKit\Panels\Panel;
use SocKit\Panels\PanelProvider;

/** Consumer-owned panel. Register this class in config/sockit.php, panels. */
final class {{CLASS}} extends PanelProvider
{
    public function panel(Panel $panel): Panel
    {
        $panel->id({{ID}})->hostTypes({{HOST}})
            ->connection({{CONNECTION}})->schema({{SCHEMA}})->prefix({{PREFIX}})
            ->modules({{MODULES}});
        $models = {{MODELS}};
        // Keep consumer bindings when disabling a module; only active owners enter the runtime map.
        $owners = {{MODEL_OWNERS}};
        foreach ($owners as $entity => $owner) {
            if ($owner !== 'sockit.kernel' && ! in_array($owner, $panel->selectedModules(), true)) {
                unset($models[$entity]);
            }
        }

        return $panel->models($models);
    }
}
