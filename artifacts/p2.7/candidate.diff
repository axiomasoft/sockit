+<?php
+
+declare(strict_types=1);
+
+require dirname(__DIR__, 3).'/vendor/autoload.php';
+
+use Illuminate\Database\Events\QueryExecuted;
+use SocKit\Audience\Contracts\ActionAuthorizer;
+use SocKit\Operations\Data\CommandEnvelope;
+use SocKit\Support\Data\CommandKey;
+use SocKit\Support\Data\CommandNamespace;
+use SocKit\Support\Data\Revision;
+use SocKit\Surfaces\SurfaceInstances;
+use SocKit\Tests\Fixtures\Runtime\EnvelopeAuthority;
+use SocKit\Tests\Fixtures\Runtime\EnvelopeScenario;
+
+$s = new EnvelopeScenario(install: false);
+$connection = $s->base->db->capsule->getConnection('owner_a');
+$connection->statement("SET statement_timeout='10s'");
+$authority = new EnvelopeAuthority($connection);
+$s->base->app->instance(abstract: ActionAuthorizer::class, instance: $authority);
+$pid = $connection->scalar('SELECT pg_backend_pid()');
+if (! is_int($pid)) {
+    throw new RuntimeException('Invalid contender backend PID');
+}
+fwrite(STDOUT, $pid.PHP_EOL);
+fflush(STDOUT);
+$role = $argv[1];
+$mode = $argv[2];
+$held = false;
+if ($role === 'hold') {
+    $connection->listen(function (QueryExecuted $query) use (&$held, $mode): void {
+        if (! $held && str_starts_with($query->sql, 'update') && (str_contains($query->sql, 'envelope_state') || (in_array($mode, ['archive', 'delete'], true) && str_contains($query->sql, 'a_surface_instances')))) {
+            $held = true;
+            fwrite(STDOUT, "claimed\n");
+            fflush(STDOUT);
+            stream_set_timeout(STDIN, 10);
+            if (trim((string) fgets(STDIN)) !== 'release') {
+                throw new RuntimeException('Missing envelope barrier');
+            }
+            if ($mode === 'rollback') {
+                throw new RuntimeException('injected winner rollback');
+            }
+        }
+    });
+}
+if ($role === 'wait' && $mode === 'digest') {
+    $s->mutation->value = 2;
+}
+if ($role === 'hold' && in_array($mode, ['archive', 'delete'], true)) {
+    $lifecycle = $s->base->app->make(SurfaceInstances::class);
+    $command = new CommandEnvelope(key: new CommandKey('req.2026-10-28.lifecycle'), namespace: new CommandNamespace(installation: $s->handle->actor->installation, panel: $s->handle->surface->panel, integration: 'acme.client', commandType: 'sockit.surfaces.'.$mode),
+        digest: $lifecycle->digest(handle: $s->handle, action: $mode, expectedRevision: new Revision(1)), expectedRevision: new Revision(1));
+    $result = $lifecycle->$mode(handle: $s->handle, command: $command);
+} else {
+    $key = $mode === 'cas' && $role === 'wait' ? 'req.2026-10-28.cas2' : 'req.2026-10-28.0001';
+    $result = $s->execute($s->command(key: $key));
+}
+if ($role === 'lost') {
+    $connection->disconnect();
+    fwrite(STDERR, "P2.7 lost response after REAL commit; no outcome returned\n");
+    exit(0);
+}
+fwrite(STDOUT, json_encode(['result' => $result->toWire(), 'writes' => $s->mutation->writes, 'resolvers' => $s->target->levels, 'authority' => $authority->levels, 'level' => $connection->transactionLevel()], JSON_THROW_ON_ERROR).PHP_EOL);

diff --git a/tests/Integration/Runtime/EnvelopeAtomicityTest.php b/tests/Integration/Runtime/EnvelopeAtomicityTest.php
new file mode 100644
index 0000000..1e48bc0
--- /dev/null
+++ b/tests/Integration/Runtime/EnvelopeAtomicityTest.php
@@ -0,0 +1,83 @@
+<?php
+
+declare(strict_types=1);
+
+use Illuminate\Database\Events\QueryExecuted;
+use Illuminate\Database\Events\TransactionCommitting;
+use SocKit\Errors\Enums\ProblemCode;
+use SocKit\Tests\Fixtures\Runtime\EnvelopeScenario;
+
+it('commits one state revision receipt and outbox and replays only original references', function (): void {
+    $s = new EnvelopeScenario;
+    try {
+        $first = $s->execute();
+        expect($first->isSuccess())->toBeTrue();
+        $second = $s->execute();
+        $lookup = $s->operations->lookup(handle: $s->handle, namespace: $s->command()->namespace, key: $s->command()->key);
+        expect($second->toWire())->toBe($first->toWire())->and($lookup?->toWire())->toBe($first->toWire())
+            ->and($s->mutation->writes)->toBe(1)->and($s->counts())->toBe(['effects' => 1, 'revision' => 2, 'receipts' => 1, 'outbox' => 1])
+            ->and($s->base->consumer->calls)->toBe(0);
+    } finally {
+        $s->cleanup();
+    }
+});
+
+it('rolls back every set on a real SQL fault at each persist boundary', function (string $stage): void {
+    $s = new EnvelopeScenario;
+    try {
+        $connection = $s->base->db->capsule->getConnection('owner_a');
+        $armed = true;
+        $throw = function () use (&$armed): void {
+            if ($armed) {
+                $armed = false;
+                throw new RuntimeException('injected owner fault');
+            }
+        };
+        if ($stage === 'before_commit') {
+            ($connection->getEventDispatcher() ?? throw new RuntimeException('Missing event dispatcher'))->listen(TransactionCommitting::class, $throw);
+        } else {
+            $connection->listen(function (QueryExecuted $q) use ($stage, $throw): void {
+                $sql = $q->sql;
+                if (($stage === 'state' && str_starts_with($sql, 'update') && str_contains($sql, 'envelope_state'))
+                    || ($stage === 'revision' && str_starts_with($sql, 'update') && str_contains($sql, 'envelope_revisions'))
+                    || ($stage === 'receipt' && str_starts_with($sql, 'update') && str_contains($sql, '"outcome"'))
+                    || ($stage === 'outbox' && str_starts_with($sql, 'INSERT') && str_contains($sql, 'a_outbox'))) {
+                    $throw();
+                }
+            });
+        }
+        $result = $s->execute();
+        expect($result->isSuccess())->toBeFalse()->and($armed)->toBeFalse()->and($s->counts())->toBe(['effects' => 0, 'revision' => 1, 'receipts' => 0, 'outbox' => 0])
+            ->and($connection->transactionLevel())->toBe(0)->and($connection->getPdo()->inTransaction())->toBeFalse()->and($s->base->consumer->calls)->toBe(0);
+    } finally {
+        $s->cleanup();
+    }
+})->with(['state', 'revision', 'receipt', 'outbox', 'before_commit']);
+
+it('rejects a nested owner transaction without changing or completing the caller transaction', function (): void {
+    $s = new EnvelopeScenario;
+    try {
+        $command = $s->command();
+        $connection = $s->base->db->capsule->getConnection('owner_a');
+        $connection->beginTransaction();
+        try {
+            expect($s->execute($command)->problem)->toBe(ProblemCode::ConfigurationInvalid)->and($s->mutation->locks)->toBe(0)->and($s->target->levels)->toBe([])
+                ->and($connection->transactionLevel())->toBe(1)->and($connection->getPdo()->inTransaction())->toBeTrue();
+        } finally {
+            $connection->rollBack();
+        }
+        expect($s->counts())->toBe(['effects' => 0, 'revision' => 1, 'receipts' => 0, 'outbox' => 0]);
+    } finally {
+        $s->cleanup();
+    }
+});
+
+it('rolls back owner protocol violations instead of trusting a successful effect DTO', function (string $bad): void {
+    $s = new EnvelopeScenario;
+    try {
+        $s->mutation->bad = $bad;
+        expect($s->execute()->isSuccess())->toBeFalse()->and($s->counts())->toBe(['effects' => 0, 'revision' => 1, 'receipts' => 0, 'outbox' => 0]);
+    } finally {
+        $s->cleanup();
+    }
+})->with(['rows', 'revision', 'events', 'generation', 'safety']);

